"""Install a downloaded Boomerang update, as root (started by pkexec from boomerangd).

Usage: boomerang-install-update <path to the .deb> <expected SHA-256> [package]

The .deb sits in the user's cache, which any program of the session may write to:
checking it there and then handing that path to apt would leave a window to swap
the file between the two. So this helper copies it into a directory only root can
reach, computes the SHA-256 of that copy, checks it is the expected package
(« boomerang », or an optional app: « agenda » or « cassette »), and installs the copy. Self-contained (python3 -I, standard library only): as root
it never imports code from a user-writable place.
"""

import hashlib
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

MAX_DEB = 200 * 1024 * 1024
# Boomerang and the optional apps it offers to install (boomerangd/apps.py).
PACKAGES = ("boomerang", "agenda", "cassette")
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8",
       "DEBIAN_FRONTEND": "noninteractive"}


def fail(message, code=1):
    print(f"boomerang-install-update: {message}", file=sys.stderr)
    return code


def main(argv):
    if len(argv) not in (3, 4):
        return fail("usage: boomerang-install-update <file.deb> <sha256> [package]", 2)
    source, expected = argv[1], argv[2].lower()
    package = argv[3] if len(argv) == 4 else "boomerang"
    if package not in PACKAGES:
        return fail("not a package Boomerang installs", 2)
    if not re.fullmatch(r"[0-9a-f]{64}", expected):
        return fail("invalid SHA-256", 2)
    if not source.endswith(".deb"):
        return fail("not a .deb file", 2)
    if os.geteuid() != 0:
        return fail("must run as root (through pkexec)", 2)
    try:
        fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as error:
        return fail(f"cannot open the package ({error.strerror})")
    workdir = tempfile.mkdtemp(prefix="boomerang-update-")  # 0700, owned by root
    copy = os.path.join(workdir, "boomerang.deb")
    try:
        with os.fdopen(fd, "rb") as src:
            if not stat.S_ISREG(os.fstat(src.fileno()).st_mode):
                return fail("not a regular file")
            digest, size = hashlib.sha256(), 0
            with open(copy, "xb") as out:
                while True:
                    chunk = src.read(1 << 20)
                    if not chunk:
                        break
                    size += len(chunk)
                    if size > MAX_DEB:
                        return fail("package too large")
                    digest.update(chunk)
                    out.write(chunk)
        if digest.hexdigest() != expected:
            return fail("SHA-256 mismatch: the package was changed after its check")
        name = subprocess.run(["dpkg-deb", "--field", copy, "Package"], env=ENV,
                              capture_output=True, text=True, timeout=60).stdout.strip()
        if name != package:
            return fail(f"not the {package} package")
        # _apt cannot read the root-only copy: apt warns and installs it as root, as wanted.
        return subprocess.run(["apt-get", "install", "-y", copy], env=ENV).returncode
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
