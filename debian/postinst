set -e

if [ "$1" = "configure" ]; then
    # Start the Boomerang daemon with every graphical session.
    systemctl --global enable boomerangd.service >/dev/null 2>&1 || true
    # Link left by Covalence, the former name (its unit file is gone with it).
    rm -f /etc/systemd/user/graphical-session.target.wants/covalenced.service
fi

#DEBHELPER#

exit 0
