#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 melvincouwez-alt

%:
	dh $@ --buildsystem=meson

# User units: only boomerangd is enabled for every user (postinst). The iCloud
# Drive and iCloud Photos mounts are enabled by Boomerang per user, after sign-in.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# The symbols file of elementary's daily Granite dates secondary_text 7.8.0; the newest
# API Boomerang uses is HeaderLabel.size (7.7.0). Same fix as packaging/build-deb.sh.
override_dh_shlibdeps:
	dh_shlibdeps
	sed -i 's/libgranite7 ([^)]*)/libgranite7 (>= 7.7.0)/' debian/boomerang.substvars
